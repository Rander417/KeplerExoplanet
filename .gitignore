# ---------------------------------------------------------------------------
# Project-specific (2026 refresh)
# ---------------------------------------------------------------------------
# Regenerable data and trained models stay out of git
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Hyperparameter-search output (the 2020 keras-tuner checkpoints were 52 MB)
tuningOutput/
keras_tuner/
lightning_logs/
runs/

# Obsidian: keep shared settings, ignore per-machine state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/*/data.json

# Tooling
.ruff_cache/
uv-cache/
.venv/
*.bundle
!.python-version

